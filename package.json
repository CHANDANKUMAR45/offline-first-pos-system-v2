{
  "name": "hybrid-pos-system",
  "version": "1.0.0",
  "main": "electron/main.js",
  "scripts": {
    "dev:react": "vite",
    "dev:electron": "node electron/dev-runner.js",
    "dev": "node scripts/start-installer.js && concurrently -k \"npm run dev:react\" \"npm run dev:electron\"",
    "build": "vite build",
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "package": "npm run package:win",
    "package:win": "node scripts/package-win.js",
    "test": "npm run build && node scripts/smoke-test.js",
    "demo:pos": "node scripts/sample-pos-demo.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanjid191/Hybrid-POS-System-Electron-React-SQLite-PostgreSQL-Cloud-Sync-.git"
  },
  "keywords": [],
  "author": {
    "name": "Hybrid POS"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/sanjid191/Hybrid-POS-System-Electron-React-SQLite-PostgreSQL-Cloud-Sync-/issues"
  },
  "homepage": "https://github.com/sanjid191/Hybrid-POS-System-Electron-React-SQLite-PostgreSQL-Cloud-Sync-#readme",
  "description": "Hybrid POS Offline First Checkout Solution",
  "build": {
    "appId": "com.sanjid.hybridpos",
    "productName": "Hybrid POS",
    "artifactName": "Hybrid-POS-Setup-${version}.${ext}",
    "directories": {
      "output": "C:\\HybridPOS-installer"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "database/**/*",
      "build/win-icon.ico",
      "package.json"
    ],
    "npmRebuild": false,
    "win": {
      "icon": "build/win-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "shortcutName": "Hybrid POS"
    },
    "asarUnpack": [
      "**/*.node"
    ]
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.8.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.5",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "electron-rebuild": "^3.2.9",
    "vite": "^8.0.1",
    "wait-on": "^9.0.4"
  }
}
